AUDIT_ROUTER_CONFIG={"destinations":{"topics":{"confluent-audit-log-events":{"retention_ms":604800000}}},"default_topics":{"allowed":"confluent-audit-log-events","denied":"confluent-audit-log-events"},"excluded_principals":["User:kafka-broker","User:kafka-controller"],"routes":{"crn:///kafka=*/topic=orders.*":{"produce":{"allowed":"confluent-audit-log-events","denied":"confluent-audit-log-events"},"consume":{"allowed":"","denied":"confluent-audit-log-events"},"describe":{"allowed":"","denied":"confluent-audit-log-events"}},"crn:///kafka=*/topic=payments.*":{"produce":{"allowed":"confluent-audit-log-events","denied":"confluent-audit-log-events"},"consume":{"allowed":"","denied":"confluent-audit-log-events"},"describe":{"allowed":"","denied":"confluent-audit-log-events"}},"crn:///kafka=*/topic=infra.*":{"produce":{"allowed":"confluent-audit-log-events","denied":"confluent-audit-log-events"},"consume":{"allowed":"","denied":"confluent-audit-log-events"},"describe":{"allowed":"","denied":"confluent-audit-log-events"}},"crn:///kafka=*":{"produce":{"allowed":"","denied":"confluent-audit-log-events"},"consume":{"allowed":"","denied":"confluent-audit-log-events"}}}}

# 主機埠覆蓋:Windows 每次開機可能保留一段埠範圍(netsh int ipv4 show excludedportrange protocol=tcp),落在範圍內的埠 docker 綁不上。
# 平常不用設(預設值見 docker-compose.yml);被保留時在這裡改,例如 MDS 的 8091。腳本(up.sh、preflight.sh)會讀這裡的值。
