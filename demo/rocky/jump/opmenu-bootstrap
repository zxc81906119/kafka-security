#!/bin/bash
# bootstrap 包裝腳本:由 sudo 以 opbootstrap 身分執行;操作員本人讀不到 certificate,只能透過這支腳本用。
#   opmenu-bootstrap kafka <工具> <參數...>      以 bootstrap 身分執行 Kafka 指令工具
#   opmenu-bootstrap mds <METHOD> <path> [json]  以 bootstrap certificate 呼叫 MDS,最後一行印 "HTTP <code>"
# 連線位址讀 /etc/opmenu/opmenu.conf(OPMENU_BOOTSTRAP、OPMENU_MDS_URL、OPMENU_CA_PEM);certificate 固定在 /etc/opmenu/bootstrap。
set -uo pipefail
. /etc/opmenu/opmenu.conf
B=/etc/opmenu/bootstrap
case "${1:-}" in
  kafka) tool="${2:?工具}"; shift 2; case "$tool" in kafka-*) ;; *) echo "只允許 kafka-* 工具"; exit 2;; esac
         exec env KAFKA_HEAP_OPTS="-Xmx256m" "$tool" --bootstrap-server "$OPMENU_BOOTSTRAP" --command-config "$B/token-bootstrap.properties" "$@";;
  mds)   m="${2:?METHOD}"; p="${3:?path}"; b="${4:-}"
         a=(-s --max-time 10 --cacert "$OPMENU_CA_PEM" -X "$m" --cert "$B/client-bootstrap.pem" --key "$B/client-bootstrap.key" -H "Content-Type: application/json" -w $'\nHTTP %{http_code}')
         [ -n "$b" ] && a+=(-d "$b")
         for u in ${OPMENU_MDS_URL//,/ }; do out=$(curl "${a[@]}" "$u$p") && { printf '%s' "$out"; exit 0; }; done   # 多台 MDS 逐台嘗試
         echo "MDS 全部連不上:$OPMENU_MDS_URL" >&2; exit 1;;
  *)     echo "用法:opmenu-bootstrap kafka <工具> ... | mds <METHOD> <path> [json]"; exit 2;;
esac
