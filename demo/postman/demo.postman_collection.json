{
  "info": {
    "name": "Confluent 安全方案 Demo(AD 人員 + 服務)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST Proxy 與 MDS API。帳密不寫在 collection:請在 environment 的 secret 變數填入(人 = AD 帳號)。注意:服務帳號(SCRAM)不能用 Basic 進 REST Proxy(實測 401);機器請用 client 憑證(Postman:Settings → Certificates → Add client certificate,Host = localhost:8086,見 Lab 12)或原生 Kafka client。\n每個 request 的描述欄就是講稿;Tests 分頁會顯示綠/紅(符合預期與否)。"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// MDS 驗證成功後會設定 auth_token cookie;若不清除,之後「換成另一個人的帳密」的請求仍會以前一個人的身分執行(Postman 與 newman 都是)。",
          "const resolved = pm.variables.replaceIn(pm.request.url.toString());",
          "pm.cookies.jar().clear(resolved, function () {});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 沒有身分進不來",
      "description": "建立「預設全拒絕」的基準",
      "item": [
        {
          "name": "1.1 未帶帳密 → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"未帶帳密應回 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "description": "**講稿**:沒有身分,REST Proxy 直接拒絕。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics"
              ]
            }
          }
        },
        {
          "name": "1.2 密碼錯誤 → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"密碼錯誤應回 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{yujie_user}}"
                },
                {
                  "key": "password",
                  "value": "{{bad_pass}}"
                }
              ]
            },
            "description": "**講稿**:帳號是 AD 的,密碼錯誤由 AD 驗證失敗。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5 人:同一份 AD 身分用在工具上",
      "description": "同一組 AD 帳密,Postman 與 C3 是同一個身分;授權由 AD 群組對應的 role 決定",
      "item": [
        {
          "name": "5.1 gary(組長)列出 topics → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"gary 應可列出 topics\", function () { pm.response.to.have.status(200); });",
                  "pm.test('可看到 orders.events', function(){ pm.expect(pm.response.text()).to.include('orders.events'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{gary_user}}"
                },
                {
                  "key": "password",
                  "value": "{{gary_pass}}"
                }
              ]
            },
            "description": "**講稿**:gary 屬 cluster-admin、topic-admin、rbac-admin、security(沒有 SystemAdmin),看得到全部 topic。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics"
              ]
            }
          }
        },
        {
          "name": "5.2 yujie(developers)寫入 orders.events → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"yujie 應可寫入\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{yujie_user}}"
                },
                {
                  "key": "password",
                  "value": "{{yujie_pass}}"
                }
              ]
            },
            "description": "**講稿**:yujie 的權限來自 AD 群組 orders-write。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              },
              {
                "key": "Content-Type",
                "value": "application/vnd.kafka.json.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics/orders.events",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics",
                "orders.events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"value\": {\n        \"order\": \"A-3001\",\n        \"by\": \"yujie\"\n      }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "5.3 yujie 寫入 payments.events → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"yujie 寫 payments 應被拒\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{yujie_user}}"
                },
                {
                  "key": "password",
                  "value": "{{yujie_pass}}"
                }
              ]
            },
            "description": "**講稿**:最小權限:developers 只被授權 orders.*,碰 payments.* 被拒。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              },
              {
                "key": "Content-Type",
                "value": "application/vnd.kafka.json.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics/payments.events",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics",
                "payments.events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"value\": {\n        \"order\": \"A-3001\",\n        \"by\": \"yujie\"\n      }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "5.4 ming(readonly)寫入 orders.events → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ming(唯讀)寫入應被拒\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ming_user}}"
                },
                {
                  "key": "password",
                  "value": "{{ming_pass}}"
                }
              ]
            },
            "description": "**講稿**:ming 已移到唯讀群組,寫入被拒(第 4 章)。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              },
              {
                "key": "Content-Type",
                "value": "application/vnd.kafka.json.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics/orders.events",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics",
                "orders.events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"value\": {\n        \"order\": \"A-3001\",\n        \"by\": \"ming\"\n      }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "5.5 ming(readonly)列出 topics,仍看得到 orders.events → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ming 唯讀應可列出 topics\", function () { pm.response.to.have.status(200); });",
                  "pm.test('看得到 orders.events', function(){ pm.expect(pm.response.text()).to.include('orders.events'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ming_user}}"
                },
                {
                  "key": "password",
                  "value": "{{ming_pass}}"
                }
              ]
            },
            "description": "**講稿**:唯讀可以「看」:列出與讀取資料;但不能寫(5.4)。",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.kafka.v2+json"
              }
            ],
            "url": {
              "raw": "{{rest_proxy}}/topics",
              "host": [
                "{{rest_proxy}}"
              ],
              "path": [
                "topics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "M MDS API(與 C3 同一份資料)",
      "description": "C3 畫面上點的 role assignment,就是這裡查到的資料",
      "item": [
        {
          "name": "M.1 gary 登入 MDS 取得 token → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"應回 200 並含 auth_token\", function () { pm.response.to.have.status(200); });",
                  "pm.test('含 auth_token', function(){ pm.expect(pm.response.json()).to.have.property('auth_token'); }); pm.collectionVariables.set('gary_token', pm.response.json().auth_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{gary_user}}"
                },
                {
                  "key": "password",
                  "value": "{{gary_pass}}"
                }
              ]
            },
            "description": "**講稿**:AD 帳密換取 MDS token(短效),之後可用 Bearer 呼叫。",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{mds}}/security/1.0/authenticate",
              "host": [
                "{{mds}}"
              ],
              "path": [
                "security",
                "1.0",
                "authenticate"
              ]
            }
          }
        },
        {
          "name": "M.2 列出 Group:orders-write 的 role binding",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"應回 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test('含 DeveloperWrite', function(){ pm.expect(pm.response.text()).to.include('DeveloperWrite'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "**講稿**:這就是 C3「Manage role assignments」顯示的內容。",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{gary_token}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{mds}}/security/1.0/lookup/principal/Group:orders-write/resources",
              "host": [
                "{{mds}}"
              ],
              "path": [
                "security",
                "1.0",
                "lookup",
                "principal",
                "Group:orders-write",
                "resources"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clusters\": {\n    \"kafka-cluster\": \"{{kafka_cluster_id}}\"\n  }\n}"
            }
          }
        },
        {
          "name": "M.3 yujie 嘗試新增 role binding → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"非管理員不可新增 role binding\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "**講稿**:不是授權管理員(rbac-admin)就不能改授權。",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{yujie_user}}"
                },
                {
                  "key": "password",
                  "value": "{{yujie_pass}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{mds}}/security/1.0/principals/Group:orders-write/roles/DeveloperRead/bindings",
              "host": [
                "{{mds}}"
              ],
              "path": [
                "security",
                "1.0",
                "principals",
                "Group:orders-write",
                "roles",
                "DeveloperRead",
                "bindings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope\": {\n    \"clusters\": {\n      \"kafka-cluster\": \"{{kafka_cluster_id}}\"\n    }\n  },\n  \"resourcePatterns\": [\n    {\n      \"resourceType\": \"Topic\",\n      \"name\": \"payments.\",\n      \"patternType\": \"PREFIXED\"\n    }\n  ]\n}"
            }
          }
        }
      ]
    }
  ]
}