{
  "destinations": {
    "topics": {
      "confluent-audit-log-events": {
        "retention_ms": 604800000
      }
    }
  },
  "default_topics": {
    "allowed": "confluent-audit-log-events",
    "denied": "confluent-audit-log-events"
  },
  "excluded_principals": [
    "User:kafka-broker",
    "User:kafka-controller"
  ],
  "routes": {
    "crn:///kafka=*/topic=orders.*": {
      "produce": {
        "allowed": "confluent-audit-log-events",
        "denied": "confluent-audit-log-events"
      },
      "consume": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      },
      "describe": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      }
    },
    "crn:///kafka=*/topic=payments.*": {
      "produce": {
        "allowed": "confluent-audit-log-events",
        "denied": "confluent-audit-log-events"
      },
      "consume": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      },
      "describe": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      }
    },
    "crn:///kafka=*/topic=infra.*": {
      "produce": {
        "allowed": "confluent-audit-log-events",
        "denied": "confluent-audit-log-events"
      },
      "consume": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      },
      "describe": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      }
    },
    "crn:///kafka=*": {
      "produce": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      },
      "consume": {
        "allowed": "",
        "denied": "confluent-audit-log-events"
      }
    }
  }
}
