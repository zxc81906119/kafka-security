# opmenu.conf.example — 正式環境(RHEL 9 VM)的設定範本。複製成 opmenu.conf 後填入實際值。
# 只需要填「無法推算」的值;沒有列在這裡的項目,用 lib/defaults.sh 的預設值或登入後自動推算。
# 登入後可在選單項目 19 查看每個值實際用了什麼、來源是 conf、derived(推算)或 default(預設)。
OPMENU_BACKEND=vm
OPMENU_ENV_LABEL=PROD

# 連線:只要填 bootstrap。以下由它推算(可用同名設定覆蓋):
#   OPMENU_MDS_URL         = bootstrap 每台主機 + https + OPMENU_MDS_PORT(預設 8091);bootstrap 若是 VIP 或 DNS 別名、或 MDS 只開在部分 broker,請直接填 OPMENU_MDS_URL
#   OPMENU_KAFKA_CLUSTER_ID= 向 MDS 查 /v1/metadata/id
#   OPMENU_HOSTS           = BROKER_SERVICES、AUX_SERVICES 的主機 + CONTROLLER_HOSTS(它是 ssh 的允許清單,不從 cluster 推算)
OPMENU_BOOTSTRAP='kafka1.bank.local:9094,kafka2.bank.local:9094,kafka3.bank.local:9094'

# certificate 目錄:truststore(truststore.p12)、truststore 密碼檔(truststore_creds)、CA(ca.pem)預設都在這裡;檔名不同才需要個別設定
# OPMENU_CERT_DIR='/etc/kafka/secrets'

# 必須填:可重啟的服務與 controller。這些是重啟與 ssh 的允許清單,要經變更管理審過,不從 cluster 推算(broker 掛掉後就不在 cluster 的清單裡,正是需要重啟的那台)
OPMENU_BROKER_SERVICES='kafka1.bank.local:confluent-server kafka2.bank.local:confluent-server kafka3.bank.local:confluent-server'   # 主機:systemd 服務名
OPMENU_AUX_SERVICES='rest1.bank.local:confluent-kafka-rest c3.bank.local:confluent-control-center'   # 主機:systemd 服務名
OPMENU_CONTROLLER_HOSTS='ctl1.bank.local ctl2.bank.local ctl3.bank.local'   # 獨立的 KRaft controller 主機;沒有就不填

# data directory:預設 /var/lib/kafka;各 broker 的 log.dirs 不同時請填
# OPMENU_DATA_DIR='/data/kafka'

# node 登入方式
OPMENU_SSH_USER=''                 # 空 = 操作員本人帳號(node 接 AD);否則填共用維運帳號
OPMENU_SSH_AUTH=key                # key = 金鑰 | password = 用登入選單的 AD 密碼 ssh 到 node(jump host 與 node 都接 AD;需安裝 sshpass)
OPMENU_USER_FROM_OS=1              # jump host 接 AD:操作者帳號固定為作業系統登入者(只輸入 AD 密碼);jump host 不接 AD 時設 0

# 規範(依客戶規定)
OPMENU_TICKET_MODE=required        # required 必填 ticket | optional 可填可不填 | none 不問 ticket
OPMENU_TICKET_CHECK=format         # format 只檢查格式 | http 向開單系統查(lib/ticket/http.sh,依客戶 API 調整)
OPMENU_TICKET_PATTERN='^[A-Z]{2,5}-[0-9]{4}-[0-9]{3,6}$'
# OPMENU_TICKET_URL='https://itsm.bank.local/api/changes'   # http 時用
OPMENU_TOPIC_PATTERN='^[a-z][a-z0-9]+\.[a-z0-9.-]+$'
OPMENU_SVC_PATTERN='^svc-[a-z][a-z0-9-]+$'
# OPMENU_REPLICATION=3             # 建 topic 的 replication factor;預設 3,broker 少於 3 台時自動降到 broker 數
OPMENU_MIN_LOG_KEEP_DAYS=7
OPMENU_IDLE_TIMEOUT=900
OPMENU_AUDIT_GROUP_PREFIX='audit-' # 43 讀 audit 用的 consumer group prefix(audit 群組要有它的 DeveloperRead)
